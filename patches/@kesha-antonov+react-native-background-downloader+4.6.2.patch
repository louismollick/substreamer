+// taskToConfigMap is only restart metadata. URLSession already owns the live tasks.
+- (void)substreamerPersistTaskConfigMapIfNeededLocked {
+    if (!taskConfigMapDirty) return;
+    [self substreamerMarkTaskConfigMapDirtyLocked];
+    taskConfigMapDirty = NO;
+}
+
+// Must be called while sharedLock is held.
+- (void)substreamerMarkTaskConfigMapDirtyLocked {
+    taskConfigMapDirty = YES;
+    // Background callbacks can arrive after JS is suspended. Persist those changes
+    // immediately; while the app is active we coalesce all mutations until resign.
+    if ([UIApplication sharedApplication].applicationState != UIApplicationStateActive) {
+        [self substreamerPersistTaskConfigMapIfNeededLocked];
+    }
+}
