+// Keep the existing persisted config until JS consumes the completed file.
+- (void)retainCompletedDownload:(RNBGDTaskConfig *)config bytes:(int64_t)bytes {
+    config.state = NSURLSessionTaskStateCompleted;
+    config.bytesDownloaded = bytes;
+    config.bytesTotal = bytes;
+    config.errorCode = 0;
+    [idToTaskMap removeObjectForKey:config.id];
+    [idToPercentMap removeObjectForKey:config.id];
+    [idToLastBytesMap removeObjectForKey:config.id];
+    [decodeErrorRetriedIds removeObject:config.id];
+    [mmkv setData:[self serialize:taskToConfigMap] forKey:ID_TO_CONFIG_MAP_KEY];
+}
