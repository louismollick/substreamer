+#pragma mark - Substreamer trusted self-signed certificates
+
+- (NSString *)substreamerSha256FingerprintForCertificate:(SecCertificateRef)certificate {
+    CFDataRef certificateData = SecCertificateCopyData(certificate);
+    unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+    CC_SHA256(
+        CFDataGetBytePtr(certificateData),
+        (CC_LONG)CFDataGetLength(certificateData),
+        digest
+    );
+    CFRelease(certificateData);
+
+    NSMutableString *fingerprint = [NSMutableString string];
+    for (NSUInteger i = 0; i < CC_SHA256_DIGEST_LENGTH; i++) {
+        if (i > 0) {
+            [fingerprint appendString:@":"];
+        }
+        [fingerprint appendFormat:@"%02X", digest[i]];
+    }
+    return fingerprint;
+}
+
+- (NSString *)substreamerTrustedFingerprintForHost:(NSString *)host {
+    NSData *data = [[NSUserDefaults standardUserDefaults] dataForKey:@"expo_ssl_trust_store"];
+    if (data == nil) {
+        return nil;
+    }
+
+    id decoded = [NSJSONSerialization JSONObjectWithData:data options:0 error:nil];
+    if (![decoded isKindOfClass:[NSDictionary class]]) {
+        return nil;
+    }
+
+    NSDictionary *entries = (NSDictionary *)decoded;
+    id candidate = entries[host];
+    if (![candidate isKindOfClass:[NSDictionary class]]) {
+        for (id key in entries) {
+            if ([key isKindOfClass:[NSString class]] &&
+                [(NSString *)key caseInsensitiveCompare:host] == NSOrderedSame) {
+                candidate = entries[key];
+                break;
+            }
+        }
+    }
+    if (![candidate isKindOfClass:[NSDictionary class]]) {
+        return nil;
+    }
+
+    id fingerprint = ((NSDictionary *)candidate)[@"sha256Fingerprint"];
+    return [fingerprint isKindOfClass:[NSString class]] ? fingerprint : nil;
+}
+
+- (void)URLSession:(NSURLSession *)session
+    didReceiveChallenge:(NSURLAuthenticationChallenge *)challenge
+    completionHandler:(void (^)(NSURLSessionAuthChallengeDisposition disposition,
+                                NSURLCredential *credential))completionHandler
+{
+    if (![challenge.protectionSpace.authenticationMethod
+            isEqualToString:NSURLAuthenticationMethodServerTrust]) {
+        completionHandler(NSURLSessionAuthChallengePerformDefaultHandling, nil);
+        return;
+    }
+
+    SecTrustRef serverTrust = challenge.protectionSpace.serverTrust;
+    if (serverTrust == nil) {
+        completionHandler(NSURLSessionAuthChallengePerformDefaultHandling, nil);
+        return;
+    }
+
+    CFErrorRef trustError = nil;
+    BOOL systemTrusted = SecTrustEvaluateWithError(serverTrust, &trustError);
+    if (trustError != nil) {
+        CFRelease(trustError);
+    }
+    if (systemTrusted) {
+        completionHandler(NSURLSessionAuthChallengePerformDefaultHandling, nil);
+        return;
+    }
+
+    NSString *expected =
+        [self substreamerTrustedFingerprintForHost:challenge.protectionSpace.host];
+
+    CFArrayRef chain = SecTrustCopyCertificateChain(serverTrust);
+    NSString *actual = nil;
+    if (chain != nil && CFArrayGetCount(chain) > 0) {
+        SecCertificateRef leaf = (SecCertificateRef)CFArrayGetValueAtIndex(chain, 0);
+        actual = [self substreamerSha256FingerprintForCertificate:leaf];
+    }
+    if (chain != nil) {
+        CFRelease(chain);
+    }
+
+    if (expected != nil &&
+        actual != nil &&
+        [expected caseInsensitiveCompare:actual] == NSOrderedSame) {
+        completionHandler(
+            NSURLSessionAuthChallengeUseCredential,
+            [NSURLCredential credentialForTrust:serverTrust]
+        );
+        return;
+    }
+
+    completionHandler(NSURLSessionAuthChallengeCancelAuthenticationChallenge, nil);
+}
